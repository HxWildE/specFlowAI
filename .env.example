# =============================================================================
# SpecFlow AI - Environment Configuration
# =============================================================================

# Application Settings
APP_NAME="SpecFlow AI"
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1

# PostgreSQL + pgvector
POSTGRES_USER=specflow
POSTGRES_PASSWORD=specflow_secret
POSTGRES_DB=specflow_db
POSTGRES_PORT=5432
# Async connection string for SQLAlchemy with asyncpg
DATABASE_URL=postgresql+asyncpg://specflow:specflow_secret@localhost:5432/specflow_db

# Apache Kafka Broker
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_RFP_TOPIC=rfp.uploaded
KAFKA_DLQ_TOPIC=rfp.dlq
KAFKA_GROUP_ID=specflow-ai-workers

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=text-embedding-004

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
